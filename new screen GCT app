# =============================================================
# Regional Meeting Notes - Power Apps Canvas YAML
# Canvas: 1366 x 768. Existing left nav assumed 0-200px.
# All content lives in conPageRoot at X=220.
#
# PASTE ORDER: Block 0 -> 1 -> 2 -> 3 -> 4 -> 5 -> 6
# Paste each block separately. Do NOT paste whole file at once.
# =============================================================


# =============================================================
# BLOCK 0 - HIDDEN LOAD BUTTON  (paste onto screen root first)
# =============================================================
- btnLoadMonth:
    Control: Classic/Button@2.2.0
    Properties:
      X: =0
      Y: =0
      Width: =1
      Height: =1
      Visible: =false
      Text: =""
      OnSelect: |
        =Set(
            varGridStart,
            DateAdd(
                varMonthAnchor,
                -(Weekday(varMonthAnchor, StartOfWeek.Sunday) - 1),
                TimeUnit.Days
            )
        );
        Set(varGridEnd, DateAdd(varGridStart, 41, TimeUnit.Days));
        ClearCollect(
            colMeetings,
            Filter(
                'Regional Meetings',
                Region = varRegion,
                MeetingDate >= varGridStart,
                MeetingDate <= varGridEnd
            )
        );
        Clear(colActions);
        ForAll(
            colMeetings As M,
            Collect(colActions, M.'Meeting Action Items')
        )


