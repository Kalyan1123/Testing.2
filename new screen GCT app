                  BorderColor: =gblTheme.Border
                  BorderThickness: =1
            - btnCancel:
                Control: Classic/Button@2.2.0
                Properties:
                  X: =354
                  Y: =622
                  Width: =92
                  Height: =32
                  Text: ="Cancel"
                  Size: =10
                  Font: =Font.'Segoe UI'
                  Fill: =gblTheme.Card
                  Color: =gblTheme.TextDark
                  BorderColor: =gblTheme.Border
                  BorderThickness: =1
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  OnSelect: |
                    =Set(varShowModal, false);
                    Clear(colEditActions);
                    Set(varCurrentMeeting, Blank());
                    Set(varSelectedDate, Blank())
            - btnSaveMeeting:
                Control: Classic/Button@2.2.0
                Properties:
                  X: =456
                  Y: =622
                  Width: =128
                  Height: =32
                  Text: ="Save Meeting Notes"
                  Size: =10
                  Font: =Font.'Segoe UI'
                  Fill: =gblTheme.Primary
                  Color: =Color.White
                  BorderThickness: =0
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  DisplayMode: =If(IsBlank(Trim(txtMeetingTitle.Text)), DisplayMode.Disabled, DisplayMode.Edit)
                  OnSelect: |
                    =Set(
                        varSavedMeeting,
                        Patch(
                            'Regional Meetings',
                            Coalesce(varCurrentMeeting, Defaults('Regional Meetings')),
                            {
                                Name: txtMeetingTitle.Text,
                                MeetingDate: varSelectedDate,
                                Region: varRegion,
                                MeetingRecap: txtRecap.Text
                            }
                        )
                    );
                    ForAll(
                        Filter(colEditActions, !IsDeleted, !IsBlank(Trim(Description))) As A,
                        Patch(
                            'Meeting Action Items',
                            Coalesce(A.ActionRec, Defaults('Meeting Action Items')),
                            {
                                Name: A.Description,
                                'Regional Meeting': varSavedMeeting,
                                AssignedTo: A.AssignedTo,
                                DueDate: A.DueDate,
                                Status: A.Status,
                                Priority: A.Priority,
                                MeetingRegion: varRegion,
                                MeetingDate: varSelectedDate
                            }
                        )
                    );
                    ForAll(
                        Filter(colEditActions, IsDeleted, !IsBlank(ActionRec)) As D,
                        Remove('Meeting Action Items', D.ActionRec)
                    );
                    If(
                        IsEmpty(Errors('Regional Meetings')) && IsEmpty(Errors('Meeting Action Items')),
                        Select(btnLoadMonth);
                        Set(varShowModal, false);
                        Clear(colEditActions);
                        Notify("Meeting notes saved.", NotificationType.Success, 2000),
                        Notify(
                            "Save failed: " & First(Errors('Regional Meetings')).Message,
                            NotificationType.Error
                        )
                    )


