# =============================================================
# BLOCK 3 - WEEKDAY HEADER + CALENDAR GRID
# Paste INSIDE conCalendarCard
# =============================================================
- galWeekdays:
    Control: Gallery@2.15.0
    Variant: Vertical
    Properties:
      X: =0
      Y: =64
      Width: =1114
      Height: =34
      Items: =["SUN","MON","TUE","WED","THU","FRI","SAT"]
      WrapCount: =7
      TemplateSize: =34
      TemplatePadding: =0
      ShowScrollbar: =false
      Fill: =RGBA(250, 251, 252, 1)
    Children:
      - lblWeekday:
          Control: Label@2.5.1
          Properties:
            X: =0
            Y: =0
            Width: =Parent.TemplateWidth
            Height: =34
            Text: =ThisItem.Value
            Color: =gblTheme.TextMuted
            Size: =9
            FontWeight: =FontWeight.Bold
            Font: =Font.'Segoe UI'
            Align: =Align.Center
            VerticalAlign: =VerticalAlign.Middle

- galCalendar:
    Control: Gallery@2.15.0
    Variant: Vertical
    Properties:
      X: =0
      Y: =98
      Width: =1114
      Height: =438
      WrapCount: =7
      TemplateSize: =73
      TemplatePadding: =0
      ShowScrollbar: =false
      Items: |
        =ForAll(
            Sequence(42, 0, 1) As Idx,
            With(
                { _d: DateAdd(varGridStart, Idx.Value, TimeUnit.Days) },
                With(
                    { _mtg: LookUp(colMeetings, MeetingDate = _d) },
                    {
                        CellDate: _d,
                        DayNum: Day(_d),
                        InMonth: Month(_d) = Month(varMonthAnchor) && Year(_d) = Year(varMonthAnchor),
                        IsToday: _d = Today(),
                        MeetingID: _mtg.'Regional Meeting',
                        Title: _mtg.Name,
                        HasMeeting: !IsBlank(_mtg.'Regional Meeting'),
                        TotalActions: CountRows(
                            Filter(colActions, 'Regional Meeting'.'Regional Meeting' = _mtg.'Regional Meeting')
                        ),
                        OpenActions: CountRows(
                            Filter(
                                colActions,
                                'Regional Meeting'.'Regional Meeting' = _mtg.'Regional Meeting',
                                Status <> 'Status (Meeting Action Items)'.Completed
                            )
                        )
                    }
                )
            )
        )
    Children:
      - recCellBg:
          Control: Rectangle@2.3.0
          Properties:
            X: =0
            Y: =0
            Width: =Parent.TemplateWidth
            Height: =73
            BorderColor: =gblTheme.GridLine
            BorderThickness: =1
            Fill: |
              =If(
                  !ThisItem.InMonth, ColorValue("#FBFCFD"),
                  ThisItem.CellDate = varSelectedDate, gblTheme.PrimarySoft,
                  gblTheme.Card
              )
      - cirDayNum:
          Control: Circle@2.3.0
          Properties:
            X: =6
            Y: =5
            Width: =22
            Height: =22
            Visible: =ThisItem.CellDate = varSelectedDate
            Fill: =gblTheme.Primary
      - lblDayNum:
          Control: Label@2.5.1
          Properties:
            X: =6
            Y: =5
            Width: =22
            Height: =22
            Text: =ThisItem.DayNum
            Size: =9
            Font: =Font.'Segoe UI'
            FontWeight: =If(ThisItem.IsToday, FontWeight.Bold, FontWeight.Normal)
            Align: =Align.Center
            VerticalAlign: =VerticalAlign.Middle
            Color: |
              =If(
                  ThisItem.CellDate = varSelectedDate, Color.White,
                  !ThisItem.InMonth, gblTheme.TextFaint,
                  gblTheme.TextDark
              )
      - recChipNotes:
          Control: Rectangle@2.3.0
          Properties:
            X: =50
            Y: =7
            Width: =20
            Height: =18
            Visible: =ThisItem.HasMeeting
            Fill: =gblTheme.PrimarySoft
            RadiusTopLeft: =4
            RadiusTopRight: =4
            RadiusBottomLeft: =4
            RadiusBottomRight: =4
      - icoChipNotes:
          Control: Icon@2.5.0
          Variant: Document
          Properties:
            X: =53
            Y: =9
            Width: =14
            Height: =14
            Visible: =ThisItem.HasMeeting
            Icon: =Icon.Document
            Color: =gblTheme.Primary
      - recChipActions:
          Control: Rectangle@2.3.0
          Properties:
            X: =74
            Y: =7
            Width: =20
            Height: =18
            Visible: =ThisItem.TotalActions > 0
            Fill: =If(ThisItem.OpenActions > 0, gblTheme.OrangeSoft, ColorValue("#E7F6EC"))
            RadiusTopLeft: =4
            RadiusTopRight: =4
            RadiusBottomLeft: =4
            RadiusBottomRight: =4
      - icoChipActions:
          Control: Icon@2.5.0
          Variant: CheckBadge
          Properties:
            X: =77
            Y: =9
            Width: =14
            Height: =14
            Visible: =ThisItem.TotalActions > 0
            Icon: =Icon.CheckBadge
            Color: =If(ThisItem.OpenActions > 0, gblTheme.Orange, gblTheme.Green)
      - recEventCard:
          Control: Rectangle@2.3.0
          Properties:
            X: =6
            Y: =31
            Width: =Parent.TemplateWidth - 14
            Height: =36
            Visible: =ThisItem.HasMeeting
            Fill: =gblTheme.Card
            BorderColor: =gblTheme.Border
            BorderThickness: =1
            RadiusTopLeft: =4
            RadiusTopRight: =4
            RadiusBottomLeft: =4
            RadiusBottomRight: =4
      - lblEventTitle:
          Control: Label@2.5.1
          Properties:
            X: =11
            Y: =33
            Width: =Parent.TemplateWidth - 24
            Height: =16
            Visible: =ThisItem.HasMeeting
            Text: =ThisItem.Title
            Size: =8
            Font: =Font.'Segoe UI'
            Color: =gblTheme.TextDark
            VerticalAlign: =VerticalAlign.Middle
      - cirActionDot:
          Control: Circle@2.3.0
          Properties:
            X: =12
            Y: =54
            Width: =6
            Height: =6
            Visible: =ThisItem.TotalActions > 0
            Fill: =If(ThisItem.OpenActions > 0, gblTheme.Orange, gblTheme.Green)
      - lblActionCount:
          Control: Label@2.5.1
          Properties:
            X: =22
            Y: =50
            Width: =90
            Height: =14
            Visible: =ThisItem.TotalActions > 0
            Text: =ThisItem.TotalActions & If(ThisItem.TotalActions = 1, " action", " actions")
            Size: =8
            Font: =Font.'Segoe UI'
            Color: =If(ThisItem.OpenActions > 0, gblTheme.Orange, gblTheme.Green)
            VerticalAlign: =VerticalAlign.Middle
      - btnCellHit:
          Control: Classic/Button@2.2.0
          Properties:
            X: =0
            Y: =0
            Width: =Parent.TemplateWidth
            Height: =73
            Text: =""
            Fill: =RGBA(0, 0, 0, 0)
            HoverFill: =RGBA(21, 101, 192, 0.04)
            PressedFill: =RGBA(21, 101, 192, 0.08)
            BorderThickness: =0
            OnSelect: |
              =Set(varSelectedDate, ThisItem.CellDate);
              Set(varCurrentMeeting, LookUp(colMeetings, MeetingDate = ThisItem.CellDate));
              ClearCollect(
                  colEditActions,
                  ForAll(
                      Filter(
                          colActions,
                          'Regional Meeting'.'Regional Meeting' = varCurrentMeeting.'Regional Meeting'
                      ) As A,
                      {
                          TempID: GUID(),
                          ActionRec: A,
                          Description: A.Name,
                          AssignedTo: A.AssignedTo,
                          DueDate: A.DueDate,
                          Status: A.Status,
                          Priority: A.Priority,
                          IsDeleted: false
                      }
                  )
              );
              Set(varShowModal, true);
              Reset(txtMeetingTitle);
              Reset(txtRecap)


