# =====================================================================
# BEAUTIFUL CALENDAR - Power Apps Canvas YAML
# Self-contained. No gblTheme dependency. No Dataverse dependency.
# Card size: 980 x 620
#
# STEP 1 - Screen.OnVisible (paste this first, not YAML):
#
#   Set(varMonthAnchor, Date(Year(Today()), Month(Today()), 1));
#   Set(varSelectedDate, Today());
#   ClearCollect(
#       colCalEvents,
#       { EventDate: Today(),                              Title: "EMEA Bi-Weekly Sync",  AccentColor: ColorValue("#1565C0") },
#       { EventDate: Today(),                              Title: "Pipeline Review",      AccentColor: ColorValue("#F59E0B") },
#       { EventDate: DateAdd(Today(), 3, TimeUnit.Days),   Title: "APAC Standup",         AccentColor: ColorValue("#16A34A") },
#       { EventDate: DateAdd(Today(), -4, TimeUnit.Days),  Title: "Compliance Sync",      AccentColor: ColorValue("#7C3AED") },
#       { EventDate: DateAdd(Today(), 9, TimeUnit.Days),   Title: "Quarterly Planning",   AccentColor: ColorValue("#1565C0") }
#   )
#
# STEP 2 - Select the screen in the tree, Ctrl+V everything below.
# STEP 3 - Delete the demo seeder later; point colCalEvents at your table.
# =====================================================================

- conCalendar:
    Control: GroupContainer@1.3.0
    Variant: ManualLayout
    Properties:
      X: =40
      Y: =40
      Width: =980
      Height: =620
      Fill: =ColorValue("#FFFFFF")
      BorderColor: =ColorValue("#E8ECF2")
      BorderThickness: =1
      DropShadow: =DropShadow.Regular
      RadiusTopLeft: =12
      RadiusTopRight: =12
      RadiusBottomLeft: =12
      RadiusBottomRight: =12
    Children:

      # ---------------- HEADER ----------------
      - lblCalMonth:
          Control: Label@2.5.1
          Properties:
            X: =28
            Y: =18
            Width: =340
            Height: =36
            Text: =Text(varMonthAnchor, "mmmm yyyy")
            Size: =20
            FontWeight: =FontWeight.Semibold
            Font: =Font.'Segoe UI'
            Color: =ColorValue("#0F172A")
            VerticalAlign: =VerticalAlign.Middle

      - lblCalSub:
          Control: Label@2.5.1
          Properties:
            X: =30
            Y: =52
            Width: =340
            Height: =20
            Size: =9
            Font: =Font.'Segoe UI'
            Color: =ColorValue("#8A94A6")
            VerticalAlign: =VerticalAlign.Middle
            Text: |
              =With(
                  { _n: CountRows(
                          Filter(
                              colCalEvents,
                              Month(EventDate) = Month(varMonthAnchor),
                              Year(EventDate) = Year(varMonthAnchor)
                          )
                      )
                  },
                  _n & If(_n = 1, " event", " events") & " this month"
              )

      - btnToday:
          Control: Classic/Button@2.2.0
          Properties:
            X: =792
            Y: =28
            Width: =72
            Height: =32
            Text: ="Today"
            Size: =10
            Font: =Font.'Segoe UI'
            Fill: =ColorValue("#FFFFFF")
            HoverFill: =ColorValue("#F5F9FF")
            Color: =ColorValue("#1565C0")
            BorderColor: =ColorValue("#D7E3F4")
            BorderThickness: =1
            RadiusTopLeft: =8
            RadiusTopRight: =8
            RadiusBottomLeft: =8
            RadiusBottomRight: =8
            OnSelect: |
              =Set(varMonthAnchor, Date(Year(Today()), Month(Today()), 1));
              Set(varSelectedDate, Today())

      - cirPrevBg:
          Control: Circle@2.3.0
          Properties:
            X: =876
            Y: =28
            Width: =32
            Height: =32
            Fill: =ColorValue("#FFFFFF")
            BorderColor: =ColorValue("#E4E9F0")
            BorderThickness: =1

      - icoPrevMonth:
          Control: Icon@2.5.0
          Properties:
            X: =886
            Y: =38
            Width: =12
            Height: =12
            Icon: =Icon.ChevronLeft
            Color: =ColorValue("#1565C0")
            OnSelect: =Set(varMonthAnchor, DateAdd(varMonthAnchor, -1, TimeUnit.Months))

      - cirNextBg:
          Control: Circle@2.3.0
          Properties:
            X: =916
            Y: =28
            Width: =32
            Height: =32
            Fill: =ColorValue("#FFFFFF")
            BorderColor: =ColorValue("#E4E9F0")
            BorderThickness: =1

      - icoNextMonth:
          Control: Icon@2.5.0
          Properties:
            X: =926
            Y: =38
            Width: =12
            Height: =12
            Icon: =Icon.ChevronRight
            Color: =ColorValue("#1565C0")
            OnSelect: =Set(varMonthAnchor, DateAdd(varMonthAnchor, 1, TimeUnit.Months))

      - recHeaderRule:
          Control: Rectangle@2.3.0
          Properties:
            X: =0
            Y: =83
            Width: =980
            Height: =1
            Fill: =ColorValue("#EFF2F6")

      # ---------------- WEEKDAY ROW ----------------
      - galWeekdays:
          Control: Gallery@2.15.0
          Variant: Vertical
          Properties:
            X: =0
            Y: =84
            Width: =980
            Height: =34
            WrapCount: =7
            TemplateSize: =34
            TemplatePadding: =0
            ShowScrollbar: =false
            Fill: =ColorValue("#FBFCFE")
            Items: |
              =Table(
                  { Nm: "SUN", Wknd: true },
                  { Nm: "MON", Wknd: false },
                  { Nm: "TUE", Wknd: false },
                  { Nm: "WED", Wknd: false },
                  { Nm: "THU", Wknd: false },
                  { Nm: "FRI", Wknd: false },
                  { Nm: "SAT", Wknd: true }
              )
          Children:
            - lblWeekday:
                Control: Label@2.5.1
                Properties:
                  X: =0
                  Y: =0
                  Width: =Parent.TemplateWidth
                  Height: =34
                  Text: =ThisItem.Nm
                  Size: =9
                  FontWeight: =FontWeight.Bold
                  Font: =Font.'Segoe UI'
                  Color: =If(ThisItem.Wknd, ColorValue("#B2BAC7"), ColorValue("#8A94A6"))
                  Align: =Align.Center
                  VerticalAlign: =VerticalAlign.Middle

      # ---------------- MONTH GRID ----------------
      - galCalendar:
          Control: Gallery@2.15.0
          Variant: Vertical
          Properties:
            X: =0
            Y: =118
            Width: =980
            Height: =468
            WrapCount: =7
            TemplateSize: =78
            TemplatePadding: =0
            ShowScrollbar: =false
            Items: |
              =With(
                  {
                      _start: DateAdd(
                          varMonthAnchor,
                          -(Weekday(varMonthAnchor, StartOfWeek.Sunday) - 1),
                          TimeUnit.Days
                      )
                  },
                  ForAll(
                      Sequence(42, 0, 1) As Idx,
                      With(
                          { _d: DateAdd(_start, Idx.Value, TimeUnit.Days) },
                          With(
                              { _evts: Filter(colCalEvents, EventDate = _d) },
                              {
                                  CellDate: _d,
                                  DayNum: Day(_d),
                                  InMonth: Month(_d) = Month(varMonthAnchor) && Year(_d) = Year(varMonthAnchor),
                                  IsToday: _d = Today(),
                                  IsWeekend: Weekday(_d, StartOfWeek.Sunday) = 1 || Weekday(_d, StartOfWeek.Sunday) = 7,
                                  EvtCount: CountRows(_evts),
                                  TopTitle: First(_evts).Title,
                                  TopColor: Coalesce(First(_evts).AccentColor, ColorValue("#1565C0")),
                                  MoreCount: Max(CountRows(_evts) - 1, 0)
                              }
                          )
                      )
                  )
              )
          Children:

            - recCellBg:
                Control: Rectangle@2.3.0
                Properties:
                  X: =0
                  Y: =0
                  Width: =Parent.TemplateWidth
                  Height: =78
                  BorderColor: =ColorValue("#EFF2F6")
                  BorderThickness: =1
                  Fill: |
                    =If(
                        !ThisItem.InMonth,         ColorValue("#FAFBFC"),
                        ThisItem.CellDate = varSelectedDate, ColorValue("#F2F8FF"),
                        ThisItem.IsToday,          ColorValue("#F7FBFF"),
                        ThisItem.IsWeekend,        ColorValue("#FDFDFE"),
                        ColorValue("#FFFFFF")
                    )

            - cirTodayRing:
                Control: Circle@2.3.0
                Properties:
                  X: =8
                  Y: =7
                  Width: =26
                  Height: =26
                  Visible: =ThisItem.IsToday && ThisItem.CellDate <> varSelectedDate
                  Fill: =RGBA(0, 0, 0, 0)
                  BorderColor: =ColorValue("#1565C0")
                  BorderThickness: =1

            - cirDaySelected:
                Control: Circle@2.3.0
                Properties:
                  X: =8
                  Y: =7
                  Width: =26
                  Height: =26
                  Visible: =ThisItem.CellDate = varSelectedDate
                  Fill: =ColorValue("#1565C0")
                  BorderThickness: =0

            - lblDayNum:
                Control: Label@2.5.1
                Properties:
                  X: =8
                  Y: =7
                  Width: =26
                  Height: =26
                  Text: =ThisItem.DayNum
                  Size: =10
                  Font: =Font.'Segoe UI'
                  Align: =Align.Center
                  VerticalAlign: =VerticalAlign.Middle
                  FontWeight: |
                    =If(
                        ThisItem.IsToday || ThisItem.CellDate = varSelectedDate,
                        FontWeight.Semibold,
                        FontWeight.Normal
                    )
                  Color: |
                    =If(
                        ThisItem.CellDate = varSelectedDate, ColorValue("#FFFFFF"),
                        !ThisItem.InMonth,                   ColorValue("#C2C9D4"),
                        ThisItem.IsToday,                    ColorValue("#1565C0"),
                        ColorValue("#1F2937")
                    )

            - cirCountBadge:
                Control: Circle@2.3.0
                Properties:
                  X: =Parent.TemplateWidth - 30
                  Y: =11
                  Width: =18
                  Height: =18
                  Visible: =ThisItem.EvtCount > 1
                  Fill: =ColorValue("#EEF2F7")
                  BorderThickness: =0

            - lblCountBadge:
                Control: Label@2.5.1
                Properties:
                  X: =Parent.TemplateWidth - 30
                  Y: =11
                  Width: =18
                  Height: =18
                  Visible: =ThisItem.EvtCount > 1
                  Text: =ThisItem.EvtCount
                  Size: =7
                  FontWeight: =FontWeight.Bold
                  Font: =Font.'Segoe UI'
                  Color: =ColorValue("#6B7785")
                  Align: =Align.Center
                  VerticalAlign: =VerticalAlign.Middle

            - recEvtPill:
                Control: Rectangle@2.3.0
                Properties:
                  X: =10
                  Y: =36
                  Width: =Parent.TemplateWidth - 20
                  Height: =20
                  Visible: =ThisItem.EvtCount > 0
                  Fill: =ColorFade(ThisItem.TopColor, 0.88)
                  BorderThickness: =0
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4

            - recEvtAccent:
                Control: Rectangle@2.3.0
                Properties:
                  X: =10
                  Y: =36
                  Width: =3
                  Height: =20
                  Visible: =ThisItem.EvtCount > 0
                  Fill: =ThisItem.TopColor
                  BorderThickness: =0
                  RadiusTopLeft: =4
                  RadiusBottomLeft: =4

            - lblEvtTitle:
                Control: Label@2.5.1
                Properties:
                  X: =18
                  Y: =36
                  Width: =Parent.TemplateWidth - 30
                  Height: =20
                  Visible: =ThisItem.EvtCount > 0
                  Text: =ThisItem.TopTitle
                  Size: =8
                  Font: =Font.'Segoe UI'
                  Color: =ColorValue("#374151")
                  VerticalAlign: =VerticalAlign.Middle

            - lblEvtMore:
                Control: Label@2.5.1
                Properties:
                  X: =14
                  Y: =58
                  Width: =Parent.TemplateWidth - 24
                  Height: =14
                  Visible: =ThisItem.MoreCount > 0
                  Text: ="+" & ThisItem.MoreCount & " more"
                  Size: =7
                  Font: =Font.'Segoe UI'
                  Color: =ColorValue("#98A2B3")
                  VerticalAlign: =VerticalAlign.Middle

            - btnCellHit:
                Control: Classic/Button@2.2.0
                Properties:
                  X: =0
                  Y: =0
                  Width: =Parent.TemplateWidth
                  Height: =78
                  Text: =""
                  Fill: =RGBA(0, 0, 0, 0)
                  HoverFill: =RGBA(21, 101, 192, 0.05)
                  PressedFill: =RGBA(21, 101, 192, 0.10)
                  BorderThickness: =0
                  OnSelect: |
                    =Set(varSelectedDate, ThisItem.CellDate);
                    If(
                        !ThisItem.InMonth,
                        Set(varMonthAnchor, Date(Year(ThisItem.CellDate), Month(ThisItem.CellDate), 1))
                    )

      # ---------------- FOOTER ----------------
      - recFooterRule:
          Control: Rectangle@2.3.0
          Properties:
            X: =0
            Y: =586
            Width: =980
            Height: =1
            Fill: =ColorValue("#EFF2F6")

      - lblFooterSelected:
          Control: Label@2.5.1
          Properties:
            X: =28
            Y: =588
            Width: =420
            Height: =32
            Size: =9
            Font: =Font.'Segoe UI'
            Color: =ColorValue("#6B7785")
            VerticalAlign: =VerticalAlign.Middle
            Text: |
              =If(
                  IsBlank(varSelectedDate),
                  "Select a date",
                  "Selected: " & Text(varSelectedDate, "dddd, d mmmm yyyy")
              )

      - lblFooterHint:
          Control: Label@2.5.1
          Properties:
            X: =640
            Y: =588
            Width: =312
            Height: =32
            Text: ="Click any date to open it"
            Size: =9
            Font: =Font.'Segoe UI'
            Color: =ColorValue("#B2BAC7")
            Align: =Align.Right
            VerticalAlign: =VerticalAlign.Middle


# =====================================================================
# BIND TO REAL DATA
# Replace the demo ClearCollect with your own shape:
#
#   ClearCollect(
#       colCalEvents,
#       ForAll(
#           Filter('Regional Meetings', Region = varRegion) As M,
#           {
#               EventDate:   M.MeetingDate,
#               Title:       M.Name,
#               AccentColor: Switch(
#                   M.Region.Value,
#                   "EMEA",        ColorValue("#1565C0"),
#                   "APAC",        ColorValue("#16A34A"),
#                   "AMR",         ColorValue("#F59E0B"),
#                   "Middle East", ColorValue("#7C3AED"),
#                                  ColorValue("#6B7785")
#               )
#           }
#       )
#   )
#
# EventDate must be Date Only. If it carries a time component the
# equality test in the grid Items will never match. Force it:
#   EventDate: DateValue(Text(M.MeetingDate, "yyyy-mm-dd"))
# =====================================================================


# =====================================================================
# IF PASTE FAILS
#
# 1. Version mismatch - drop a Label in your app, Ctrl+C, paste into
#    Notepad, read the real "Control: Label@x.x.x" and find-replace.
#
# 2. DropShadow not supported on your GroupContainer version -
#    delete that one line from conCalendar.
#
# 3. ColorFade unavailable - swap recEvtPill.Fill for a flat tint:
#       Fill: =ColorValue("#EEF4FC")
#
# 4. Parent.TemplateWidth shows 0 - click into the property and retype
#    it once. Studio re-resolves the binding.
# =====================================================================
