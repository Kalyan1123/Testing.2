- recProbe:
    Control: Rectangle
    Properties:
      X: =40
      Y: =100
      Width: =120
      Height: =40
      Fill: =ColorValue("#1565C0")
- cirProbe:
    Control: Circle
    Properties:
      X: =180
      Y: =100
      Width: =40
      Height: =40
      Fill: =ColorValue("#F59E0B")
- icoProbe:
    Control: Icon
    Properties:
      X: =240
      Y: =108
      Width: =24
      Height: =24
      Icon: =Icon.ChevronRight
      Color: =ColorValue("#1565C0")
- btnProbe:
    Control: Button
    Properties:
      X: =290
      Y: =100
      Width: =120
      Height: =40
      Text: ="Button OK"
- galProbe:
    Control: Gallery
    Properties:
      X: =40
      Y: =170
      Width: =700
      Height: =80
      WrapCount: =7
      TemplateSize: =80
      ShowScrollbar: =false
      Items: =ForAll(Sequence(7, 1, 1) As I, { N: I.Value })
    Children:
      - lblProbeCell:
          Control: Label
          Properties:
            X: =0
            Y: =0
            Width: =Parent.TemplateWidth
            Height: =80
            Text: =ThisItem.N
            Align: =Align.Center
