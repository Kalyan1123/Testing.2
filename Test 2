- galCalendar:
    Control: Gallery@2.15.0
    Variant: BrowseLayout_Vertical_TwoTextOneImageVariant_ver5.0
    Properties:
      X: =0
      Y: =118
      Width: =Parent.Width
      Height: =Parent.Height - 152
      WrapCount: =7
      TemplateSize: =(Parent.Height - 152) / 6
      TemplatePadding: =0
      ShowScrollbar: =false
      BorderColor: =RGBA(0, 0, 0, 0)
      Items: |
        =With(
            { _a: Coalesce(varCalMonth, Date(Year(Today()), Month(Today()), 1)) },
            With(
                {
                    _start: DateAdd(_a, -(Weekday(_a, StartOfWeek.Sunday) - 1), TimeUnit.Days),
                    _src: Table(
                        { EventDate: Today(), Title: "EMEA Bi-Weekly Sync" },
                        { EventDate: Today(), Title: "Pipeline Review" },
                        { EventDate: DateAdd(Today(), 3, TimeUnit.Days), Title: "APAC Standup" },
                        { EventDate: DateAdd(Today(), -4, TimeUnit.Days), Title: "Compliance Sync" },
                        { EventDate: DateAdd(Today(), 9, TimeUnit.Days), Title: "Quarterly Planning" }
                    )
                },
                ForAll(
                    Sequence(42, 0, 1) As Idx,
                    With(
                        { _d: DateAdd(_start, Idx.Value, TimeUnit.Days) },
                        With(
                            { _evts: Filter(_src, EventDate = _d) },
                            {
                                CellDate: _d,
                                DayNum: Day(_d),
                                InMonth: Month(_d) = Month(_a) && Year(_d) = Year(_a),
                                IsToday: _d = Today(),
                                IsWeekend: Weekday(_d, StartOfWeek.Sunday) = 1 || Weekday(_d, StartOfWeek.Sunday) = 7,
                                EvtCount: CountRows(_evts),
                                TopTitle: First(_evts).Title,
                                MoreCount: Max(CountRows(_evts) - 1, 0)
                            }
                        )
                    )
                )
            )
        )
    Children:
      - recCellBg:
          Control: Rectangle@2.3.0
          Properties:
            X: =0
            Y: =0
            Width: =Parent.TemplateWidth
            Height: =Parent.TemplateHeight
            BorderColor: =RGBA(239, 242, 246, 1)
            Fill: |
              =If(
                  !ThisItem.InMonth,
                  RGBA(250, 251, 252, 1),
                  ThisItem.CellDate = Coalesce(varCalSelected, Today()),
                  RGBA(242, 248, 255, 1),
                  ThisItem.IsToday,
                  RGBA(247, 251, 255, 1),
                  ThisItem.IsWeekend,
                  RGBA(253, 253, 254, 1),
                  RGBA(255, 255, 255, 1)
              )
      - recTodayRing:
          Control: Rectangle@2.3.0
          Properties:
            X: =8
            Y: =7
            Width: =26
            Height: =26
            Visible: =ThisItem.IsToday && ThisItem.CellDate <> Coalesce(varCalSelected, Today())
            Fill: =RGBA(0, 0, 0, 0)
            BorderColor: =RGBA(21, 101, 192, 1)
            RadiusTopLeft: =13
            RadiusTopRight: =13
            RadiusBottomLeft: =13
            RadiusBottomRight: =13
      - recDaySelected:
          Control: Rectangle@2.3.0
          Properties:
            X: =8
            Y: =7
            Width: =26
            Height: =26
            Visible: =ThisItem.CellDate = Coalesce(varCalSelected, Today())
            Fill: =RGBA(21, 101, 192, 1)
            BorderColor: =RGBA(0, 0, 0, 0)
            RadiusTopLeft: =13
            RadiusTopRight: =13
            RadiusBottomLeft: =13
            RadiusBottomRight: =13
      - lblDayNum:
          Control: Label@2.5.1
          Properties:
            X: =8
            Y: =7
            Width: =26
            Height: =26
            Text: =ThisItem.DayNum
            Size: =10
            Font: =Font.'Segoe UI'
            Fill: =RGBA(0, 0, 0, 0)
            BorderColor: =RGBA(0, 0, 0, 0)
            Align: =Align.Center
            VerticalAlign: =VerticalAlign.Middle
            PaddingTop: =0
            PaddingBottom: =0
            PaddingLeft: =0
            PaddingRight: =0
            FontWeight: |
              =If(
                  ThisItem.IsToday || ThisItem.CellDate = Coalesce(varCalSelected, Today()),
                  FontWeight.Semibold,
                  FontWeight.Normal
              )
            Color: |
              =If(
                  ThisItem.CellDate = Coalesce(varCalSelected, Today()),
                  RGBA(255, 255, 255, 1),
                  !ThisItem.InMonth,
                  RGBA(194, 201, 212, 1),
                  ThisItem.IsToday,
                  RGBA(21, 101, 192, 1),
                  RGBA(31, 41, 55, 1)
              )
      - recCountBadge:
