- lblClassicTest:
    Control: Classic/Label
    Properties:
      X: =40
      Y: =40
      Width: =160
      Height: =32
      Text: ="Classic label"
      Fill: =ColorValue("#E8F1FC")
      RadiusTopLeft: =6
- btnClassicTest:
    Control: Classic/Button
    Properties:
      X: =220
      Y: =40
      Width: =140
      Height: =32
      Text: ="Classic button"
      RadiusTopLeft: =6
- icoClassicTest:
    Control: Classic/Icon
    Properties:
      X: =380
      Y: =40
      Width: =24
      Height: =24
      Icon: =Icon.ChevronLeft
      Color: =ColorValue("#1565C0")
      OnSelect: =false
- galTest:
    Control: Gallery
    Variant: Vertical
    Properties:
      X: =40
      Y: =100
      Width: =700
      Height: =80
      WrapCount: =7
      TemplateSize: =80
      Items: =ForAll(Sequence(7, 1, 1) As I, { N: I.Value })
    Children:
      - lblCell:
          Control: Classic/Label
          Properties:
            X: =0
            Y: =0
            Width: =Parent.TemplateWidth
            Height: =80
            Text: =ThisItem.N
            Align: =Align.Center
